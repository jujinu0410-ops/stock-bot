FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY mobile_v8/requirements-service.txt /tmp/requirements-service.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-service.txt

COPY mobile_v8 /app/mobile_v8

CMD ["sh", "-c", "exec gunicorn --bind :${PORT:-8080} --workers 1 --threads 8 --timeout 0 mobile_v8.web_app:app"]
